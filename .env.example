# Portas do ambiente local (compose.yaml). Copie para `.env` só se precisar mudar alguma.
# Tudo escuta apenas em 127.0.0.1. Padrões abaixo; 8080 fica livre de propósito (muito usada).
# WEB_PORT=3000
# API_PORT=8081
# MAILPIT_WEB_PORT=8025
# MAILPIT_SMTP_PORT=1025
# DB_PORT=5432
# REDIS_PORT=6379
# LOG_LEVEL=info
